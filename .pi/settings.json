{
  "defaultProvider": "quest",
  "defaultModel": "auto",
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 5,
      "maxRetryDelayMs": 30000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 4096,
    "keepRecentTokens": 20000
  },
  "pi-quest": {
    "askTimeoutMs": 60000,
    "depthCap": 3,
    "strictMode": true,
    "draftThresholds": {
      "requirements": 2,
      "evidence": 7
    },
    "bindings": {
      "reviewRunner": {
        "tool": "subagent"
      }
    },
    "reviewPolicy": "strict",
    "judgeFallback": "heuristic",
    "roles": {
      "reviewer": [
        "anthropic/claude-sonnet-5-5:low",
        "antigravity/claude-sonnet-5-5"
      ],
      "validator": [
        "antigravity/gemini-3.8-flash",
        "antigravity/claude-sonnet-5-5"
      ]
    },
    "router": {
      "enabled": true,
      "provider": "quest",
      "id": "auto",
      "default": "antigravity/gemini-3.8-flash",
      "direct": "antigravity/gemini-3.8-flash:low",
      "cooldownMs": 900000,
      "matrix": {
        "drafting": {
          "complex": [
            "anthropic/claude-sonnet-5-5:high",
            "antigravity/gemini-3.8-flash"
          ],
          "*": "antigravity/gemini-3.8-flash"
        },
        "implementing": "antigravity/gemini-3.8-flash",
        "validating": "antigravity/gemini-3.8-flash"
      }
    }
  },
  "pi-mm": {
    "judgeMode": "auto",
    "judgeUrl": "http://127.0.0.1:4242",
    "judgeModel": "qwen",
    "judgeTimeoutMs": 15000,
    "embedUrl": "http://127.0.0.1:4242/v1/embeddings",
    "embedModel": "bge-small",
    "semanticSearch": true,
    "ephemeralSepal": true
  },
  "pi-early-compact": {
    "tiers": [
      {
        "upTo": 200000,
        "pct": 80
      },
      {
        "upTo": 1000000,
        "pct": 50
      }
    ]
  }
}
