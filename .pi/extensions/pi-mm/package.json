{
  "name": "pi-mm",
  "version": "0.1.0",
  "description": "Memory Mipmaps extension for Pi Coding Agent — persistent, hierarchical, low-cost recall over local qmap files (memory_scan/think/store/forget/reset). Phase 3 of mm-plan.",
  "keywords": [
    "pi-package"
  ],
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test": "deno test --allow-all --sloppy-imports --node-modules-dir=none tests/",
    "zip": "deno run --allow-all scripts/zip_bundle.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "skills": [
      "skills/pi-mm/SKILL.md"
    ]
  }
}