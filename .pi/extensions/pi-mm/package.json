{
  "name": "pi-mm",
  "version": "0.1.0",
  "description": "Memory Mipmaps extension for Pi Coding Agent — persistent, hierarchical recall with automatic bounded context injection and streamlined memory_recall, memory_record, memory_review tools.",
  "keywords": [
    "pi-package"
  ],
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test": "deno test --allow-all --sloppy-imports --node-modules-dir=none tests/",
    "benchmark": "deno run --allow-all scripts/benchmark-mm.ts",
    "zip": "deno run --allow-all scripts/zip_bundle.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "skills": [
      "skills/pi-mm/SKILL.md"
    ]
  }
}
