{
  "name": "pi-quest",
  "version": "1.0.0",
  "description": "Quest Journal & Epistemic Workflow Extension for Pi Coding Agent",
  "keywords": [
    "pi-package"
  ],
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test": "deno test --allow-all --node-modules-dir=none tests/",
    "zip": "deno run --allow-all scripts/zip_bundle.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-agent-core": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "pi-subagents": { "optional": true }
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "skills": [
      "skills/quest-journal/SKILL.md"
    ]
  }
}
