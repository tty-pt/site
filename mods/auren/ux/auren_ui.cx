#ifndef AUREN_UI_C
#define AUREN_UI_C

#include "site_cx.h"
#include "auren_ui.h"

static bud_node *render_msg(const auren_demo_msg_t *msg)
{
	int is_user = (strcmp(msg->role, "user") == 0);
	const char *role_class = is_user ? "msg-user" : "msg-assistant";
	const char *role_label = is_user ? "User" : "Assistant (Local GPU)";
	char cls[64];
	snprintf(cls, sizeof(cls), "auren-msg %s", role_class);

	return (
		<div class={cls}>
			<div class="auren-msg-header">{role_label}</div>
			<div class="auren-msg-body">{msg->content}</div>
		</div>
	);
}

bud_node *auren_ui_render_view(const auren_demo_state_t *st)
{
	/* Build message list */
	bud_node *msg_list = NULL;
	if (st->msg_count > 0 || st->streaming) {
		msg_list = bud_fragment();
		for (size_t i = 0; i < st->msg_count; i++)
			bud_append(msg_list, render_msg(&st->msgs[i]));

		if (st->streaming) {
			bud_append(
			        msg_list,
			        <div class="auren-msg msg-assistant streaming">
			                <div class="auren-msg-header">
			                        Assistant (Local GPU - Streaming)
			                </div>
			                <div class="auren-msg-body">
			                        {st->current_response}
			                        <span class="auren-cursor" />
			                </div>
			        </div>);
		}
	} else {
		msg_list = (
			<div class="auren-empty-state">
				<p>No messages yet. Ask a question to run client-side neural inference!</p>
			</div>
		);
	}

	/* Build hardware badge */
	const char *badge_class = st->webgpu_available
	        ? "auren-badge badge-gpu-on"
	        : "auren-badge badge-gpu-wait";
	const char *badge_text = st->webgpu_available
	        ? "WebGPU Active (Local Hardware)"
	        : "Checking Local Hardware...";

	/* Progress bar if downloading */
	bud_node *progress_node = NULL;
	if (st->percent < 100 && !st->cached) {
		char pct_buf[32];
		char style_buf[64];
		snprintf(pct_buf, sizeof(pct_buf), "%d%%", st->percent);
		snprintf(style_buf, sizeof(style_buf), "width: %s;", pct_buf);
		progress_node = (
			<div class="auren-progress-box">
				<div class="auren-progress-label">
					{"Downloading model weights to browser cache: "}
					{pct_buf}
				</div>
				<div class="auren-progress-bar">
					<div class="auren-progress-fill" style={style_buf} />
				</div>
			</div>
		);
	} else if (st->cached) {
		progress_node = (
			<div class="auren-cache-pill">
				<span class="cache-icon">{"\xe2\x9a\xa1"}</span>
				{" Weights cached locally in browser storage (0 bytes transferred)"}
			</div>
		);
	}

	return (
		<div class="auren-container">
			<div class="auren-header">
				<div class="auren-title-row">
					<h1>Auren In-Browser LLM Demo</h1>
					<span class={badge_class}>{badge_text}</span>
				</div>
				<p class="auren-desc">
					{"Powered by "}
					<strong>SmolLM2-135M-Instruct</strong>
					{" (Ultra-Lightweight Default) and "}
					<strong>Qwen2.5-0.5B</strong>
					{". Model weights are cached locally and evaluated entirely inside your browser via WebGPU & WebAssembly. Zero cloud tokens, zero data egress."}
				</p>
				<div class="auren-model-bar">
					<label for="auren-model-select">Model:</label>
					<select id="auren-model-select" class="auren-select">
						<option value="smollm2" selected>
							SmolLM2-135M-Instruct (Ultra-Lightweight 90MB - Default)
						</option>
						<option value="qwen">
							Qwen2.5-0.5B-Instruct (Tier 1 Higher-Capacity)
						</option>
					</select>
				</div>
				{progress_node}
			</div>
			<div class="auren-chat-viewport">
				{msg_list}
			</div>
			<form class="auren-input-bar" id="auren-form" method="POST" action="/auren/prompt">
				<input
					type="text"
					id="auren-input"
					name="prompt"
					placeholder="Ask anything..."
					autocomplete="off"
				/>
				<button type="submit" id="auren-submit-btn" class="btn-primary">
					Generate
				</button>
			</form>
			<div class="auren-quick-prompts">
				<span class="quick-label">Quick tests:</span>
				<button
					type="button"
					class="btn-chip"
					data-prompt="Explain pointers in C in 5 words."
				>Pointers in C</button>
				<button
					type="button"
					class="btn-chip"
					data-prompt="What is the benefit of isomorphic WebAssembly?"
				>Isomorphic WASM</button>
				<button
					type="button"
					class="btn-chip"
					data-prompt="Write a short poem about Linux."
				>Linux Poem</button>
			</div>
		</div>
	);
}

#endif /* AUREN_UI_C */
