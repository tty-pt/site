static int on_settings_zoom_reset(bud_event *ev)
{
	if (ev) bud_event_stop_propagation(ev);
	nd_seven_set_zoom(1.0f);
	nd_ui_seven_stage_redraw();
	bud_app_set_state();
	return 0;
}

static bud_node *make_settings_btn(const char *id, const char *label, const char *title, bud_event_handler_fn fn)
{
	bud_node *btn = make_btn(label, title, fn);
	if (id && id[0])
		bud_set_attr(btn, "id", id);
	return btn;
}

static bud_node *settings_toggle_row(const char *label, const char *btn_id,
                                     const char *btn_title, const char *btn_text,
                                     bud_event_handler_fn on_click)
{
	return (
		<div class="settings-row-inline">
			<span class="settings-label">{label}</span>
			<button id={btn_id}
			        type="button"
			        class="settings-toggle"
			        title={btn_title}
			        onClick={on_click}>
				{btn_text}
			</button>
		</div>
	);
}

static bud_node *settings_slider_row(const char *label, const char *val_id, const char *val_text,
                                     const char *out_id, const char *out_title, bud_event_handler_fn on_out,
                                     const char *slider_id, const char *min_s, const char *max_s,
                                     const char *num_s, bud_event_handler_fn on_slide,
                                     const char *in_id, const char *in_title, bud_event_handler_fn on_in,
                                     bud_node *extra_btn)
{
	return (
		<div class="settings-row">
			<div class="settings-row-top">
				<span class="settings-label">{label}</span>
				<span id={val_id} class="settings-badge">{val_text}</span>
			</div>
			<div class="settings-slider-wrap">
				{make_settings_btn(out_id, "−", out_title, on_out)}
				<input id={slider_id}
				       type="range"
				       class="settings-slider"
				       min={min_s}
				       max={max_s}
				       step="5"
				       value={num_s}
				       onInput={on_slide}
				       onChange={on_slide} />
				{make_settings_btn(in_id, "+", in_title, on_in)}
				{extra_btn}
			</div>
		</div>
	);
}

bud_node *render_settings_modal(const nd_client_state_t *st)
{
	const char *active = nd_ui_get_active_modal();
	int is_open = (active && strcmp(active, "settings") == 0);

	int raw_res_pct = (int)(nd_seven_get_res_scale() * 100.0f + 0.5f);
	int raw_det_pct = (int)(nd_seven_get_detail_scale() * 100.0f + 0.5f);
	int cq = nd_seven_get_cloud_quality();
	int msaa_samples = nd_seven_get_msaa_samples();
	int drs = nd_seven_get_drs();
	int fps = nd_seven_get_fps_cap();
	int raw_zoom_pct = (int)(nd_seven_get_zoom() * 100.0f + 0.5f);

	char qstyle[192];
	snprintf(qstyle, sizeof(qstyle),
	         "--nd-res:%d;--nd-det:%d;--nd-cloud:%d;--nd-msaa:%d;--nd-drs:%d;--nd-fps:%d;--nd-zoom:%d;",
	         raw_res_pct, raw_det_pct, cq, msaa_samples, drs, fps, raw_zoom_pct);

	int preset = nd_seven_get_quality_preset();
	const char *preset_label = "✨ High";
	if (preset == ND_QUALITY_LOW) preset_label = "🔋 Low (Fastest)";
	else if (preset == ND_QUALITY_MEDIUM) preset_label = "⚖️ Medium (Default)";
	else if (preset == ND_QUALITY_CUSTOM) preset_label = "🎛️ Custom";

	int res_pct = raw_res_pct < 25 ? 25 : (raw_res_pct > 100 ? 100 : raw_res_pct);
	char res_val[32], res_num[16];
	snprintf(res_val, sizeof(res_val), "%d%%", res_pct);
	snprintf(res_num, sizeof(res_num), "%d", res_pct);

	int det_pct = raw_det_pct < 20 ? 20 : (raw_det_pct > 250 ? 250 : raw_det_pct);
	char det_val[32], det_num[16];
	snprintf(det_val, sizeof(det_val), "%d%%", det_pct);
	snprintf(det_num, sizeof(det_num), "%d", det_pct);

	const char *cq_label = "☁️ High (1/2 Res + CSM)";
	if (cq == ND_CLOUD_QUALITY_OFF) cq_label = "🚫 Off";
	else if (cq == ND_CLOUD_QUALITY_LOW) cq_label = "💨 Low (1/4 Res, No CSM)";
	else if (cq == ND_CLOUD_QUALITY_MEDIUM) cq_label = "⛅ Medium (1/3 Res + CSM)";

	const char *msaa_label = "Off (1x)";
	if (msaa_samples == 2) msaa_label = "2x MSAA";
	else if (msaa_samples >= 4) msaa_label = "4x MSAA";

	const char *drs_label = drs ? "Auto (75–100%)" : "Off";

	const char *fps_label = "Uncapped (VSync)";
	if (fps == 30) fps_label = "30 FPS (Battery)";
	else if (fps == 60) fps_label = "60 FPS";

	int slider_zoom_pct = raw_zoom_pct < 10 ? 10 : (raw_zoom_pct > 250 ? 250 : raw_zoom_pct);
	char zoom_val[32], zoom_num[16];
	snprintf(zoom_val, sizeof(zoom_val), "%d%%", raw_zoom_pct);
	snprintf(zoom_num, sizeof(zoom_num), "%d", slider_zoom_pct);

	const char *req_drv = (st && st->preferred_driver[0]) ? st->preferred_driver : "tty";
	int is_seven_drv = (strcmp(req_drv, "lamina-seven") == 0);

	return (
		<div id="settings-modal"
		     class={is_open
		            ? "modal fixed inset-0 z-50 flex items-center justify-center bg-black/60"
		            : "hidden"}
		     onClick={on_settings_modal_close}>
			<div id="settings"
			     class="rpg-modal-card settings-card select-none"
			     data-bud-persist-key="nd-settings-quality"
			     style={qstyle}
			     onClick={on_settings_card_click}>
				<div class="rpg-modal-header">
					<span class="settings-label">⚙️ Settings</span>
					<button id="settings-close-btn"
					        type="button"
					        class="btn round"
					        title="Close Settings"
					        onClick={on_settings_modal_close}>
						✕
					</button>
				</div>
				<div class="settings-body">
					{settings_toggle_row("⚡ Graphics Preset", "settings-preset-toggle",
					                     "Cycle graphics preset (Low / Medium / High)",
					                     preset_label, on_settings_preset_cycle)}
					{settings_slider_row("📐 Render Resolution", "settings-res-value", res_val,
					                     "settings-res-out", "Lower Render Resolution", on_settings_res_out,
					                     "settings-res-slider", "25", "100", res_num, on_settings_res_slider,
					                     "settings-res-in", "Higher Render Resolution", on_settings_res_in,
					                     NULL)}
					{settings_toggle_row("🎯 Dynamic Resolution", "settings-drs-toggle",
					                     "Auto-scale render resolution (75–100%) to keep frame rate smooth",
					                     drs_label, on_settings_drs_toggle)}
					{settings_slider_row("🌿 Scenery Detail", "settings-detail-value", det_val,
					                     "settings-detail-out", "Less Scenery Detail (,)", on_settings_detail_out,
					                     "settings-detail-slider", "20", "250", det_num, on_settings_detail_slider,
					                     "settings-detail-in", "More Scenery Detail (.)", on_settings_detail_in,
					                     NULL)}
					{settings_toggle_row("☁️ Clouds & Shadows", "settings-cloud-toggle",
					                     "Cycle volumetric cloud & shadow map quality",
					                     cq_label, on_settings_cloud_cycle)}
					{settings_toggle_row("✨ Anti-Aliasing", "settings-msaa-toggle",
					                     "Cycle multisample anti-aliasing (Off / 2x / 4x)",
					                     msaa_label, on_settings_msaa_toggle)}
					{settings_toggle_row("⏱️ Frame Rate Cap", "settings-fps-toggle",
					                     "Cycle 3D rendering frame rate cap",
					                     fps_label, on_settings_fps_cycle)}
					{settings_slider_row("🔍 Camera Zoom", "settings-zoom-value", zoom_val,
					                     "settings-zoom-out", "Zoom Out (-)", on_settings_zoom_out,
					                     "settings-zoom-slider", "10", "250", zoom_num, on_settings_zoom_slider,
					                     "settings-zoom-in", "Zoom In (+)", on_settings_zoom_in,
					                     make_settings_btn("settings-zoom-reset", "100%", "Reset Zoom (0)", on_settings_zoom_reset))}
					{settings_toggle_row("🖥️ 3D Viewport", "settings-viewport-toggle",
					                     "Toggle between 3D Seven Viewport and Terminal",
					                     is_seven_drv ? "🕹️ Seven 3D (On)" : "📺 Terminal (Off)", on_cycle_viewport)}
					<div class="settings-hint">Shortcuts: , / . Detail  |  - / + / 0 Zoom</div>
				</div>
			</div>
		</div>
	);
}
