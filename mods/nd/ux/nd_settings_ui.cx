#include "nd_ui_internal.h"

static int on_settings_modal_close(bud_event *ev)
{
	if (ev) bud_event_stop_propagation(ev);
	nd_ui_set_active_modal("");
	bud_app_set_state();
	return 0;
}

static int on_settings_card_click(bud_event *ev)
{
	if (ev) bud_event_stop_propagation(ev);
	return 0;
}

static const char *settings_event_value(bud_event *ev)
{
	if (!ev)
		return NULL;
	const char *v = (const char *)ev->user;
	if (v && v[0])
		return v;
	bud_node *n = ev->target ? ev->target : ev->current_target;
	if (n) {
		v = bud_get_attr(n, "value");
		if (v && v[0])
			return v;
	}
	return NULL;
}

static int on_settings_preset_cycle(bud_event *ev)
{
	if (ev) bud_event_stop_propagation(ev);
	nd_seven_cycle_quality_preset();
	nd_ui_seven_stage_redraw();
	bud_app_set_state();
	return 0;
}

static int on_settings_res_slider(bud_event *ev)
{
	if (ev) bud_event_stop_propagation(ev);
	const char *val_str = settings_event_value(ev);
	if (val_str && val_str[0]) {
		int pct = atoi(val_str);
		if (pct >= 25 && pct <= 100) {
			int cur_pct = (int)(nd_seven_get_res_scale() * 100.0f + 0.5f);
			nd_seven_set_res_scale((float)pct * 0.01f);
			if (pct != cur_pct) {
				nd_ui_seven_stage_redraw();
				bud_app_set_state();
			}
		}
	}
	return 0;
}

