		int pct = atoi(val_str);
		if (pct >= 20 && pct <= 250) {
			int cur_pct = (int)(nd_seven_get_detail_scale() * 100.0f + 0.5f);
			nd_seven_set_detail_scale((float)pct * 0.01f);
			if (pct != cur_pct) {
